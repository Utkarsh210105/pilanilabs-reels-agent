# Postgres. Local dev: the docker-compose database. Production: Supabase
# (Project settings > Database > Connection string, "Session pooler").
DATABASE_URL=postgresql://reels:reels@localhost:5433/reels
PORT=4100
DASHBOARD_ORIGIN=http://localhost:5174

# Claude via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model ids)
# SCRIPT_MODEL=anthropic/claude-sonnet-4.5
# FAST_MODEL=anthropic/claude-haiku-4.5

# Stock B-roll (https://www.pexels.com/api/, free)
PEXELS_API_KEY=

# Whisper word timings for captions (https://console.groq.com/keys)
GROQ_API_KEY=
# Creator reels: Instagram scraping (https://console.apify.com/settings/integrations)
APIFY_TOKEN=
# CREATOR_SCRAPE_LIMIT=30   reels fetched per creator
# CREATOR_ANALYZE_TOP=6     top reels transcribed + analysed per scrape

# ManyChat → leads webhook. Any long random string; ManyChat sends it as X-Webhook-Secret.
LEADS_WEBHOOK_SECRET=
# Public address of this server (tunnel or deployment), shown on the Leads page
# PUBLIC_URL=https://your-domain.ngrok-free.app

# Where uploaded and rendered videos are kept (default: api/media)
# MEDIA_DIR=

# Daily news run (06:00 IST)
# DAILY_B2B_DRAFTS=1
# DAILY_B2C_DRAFTS=2
# MIN_NEWS_SCORE=7
# DISABLE_SCHEDULER=true
